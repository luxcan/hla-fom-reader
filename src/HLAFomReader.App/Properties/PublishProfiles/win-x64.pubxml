<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone single-file build: one HLAFomReader.exe that runs on a machine with no .NET installed.

  PublishTrimmed is deliberately absent - WPF does not support trimming and enabling it produces a
  binary that crashes at runtime on XAML type resolution. The output is therefore large (~150 MB);
  EnableCompressionInSingleFile brings it down at the cost of a slightly slower first start.

  IncludeNativeLibrariesForSelfExtract is required: SQLitePCLRaw ships the native e_sqlite3.dll, and
  without this the bundle leaves it beside the exe instead of inside it.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\publish\win-x64\</PublishDir>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!--
      IncludeAllContentForSelfExtract is deliberately NOT set. It makes the bundle unpack itself into
      a randomly named folder under %TEMP%\.net\ and run from there, which moves
      AppContext.BaseDirectory away from the executable. config.json and the default database are
      written beside the executable, so that flag caused both to be written to a throwaway folder and
      silently lost on the next launch. The code now resolves its folder from Environment.ProcessPath
      and is immune either way, but there is no reason to extract, so do not re-add this.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
