<Window x:Class="HLAFomReader.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HLA FOM Reader"
        Width="440" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ResizeBorderThickness is 0 because the dialog is fixed size; the 36 DIP caption still drags. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Same caption button as the shell: 44 DIP wide, close hover uses ValidationError. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ValidationError}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">

                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                        Click="Dismiss_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource AccentBackground}" />
                    <TextBlock x:Name="TitleText" Text="HLA FOM Reader" Margin="9,0,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ============ Body ============
             The severity tile carries the whole signal, so the message itself never has to open with
             "Error:". It scrolls because the text is sometimes an exception rather than a sentence. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBackground}">
            <Grid Margin="20,18,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SeverityTile" Grid.Column="0"
                        Width="32" Height="32" VerticalAlignment="Top"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource AccentBackground}">
                    <TextBlock x:Name="SeverityGlyph" Text="&#xE946;"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource SymbolFontFamily}" FontSize="15"
                               Foreground="{DynamicResource AccentForeground}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText" TextWrapping="Wrap"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,6,0,0"
                               FontSize="12.5" LineHeight="18"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============ Footer ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource SubtleButton}"
                        Height="30" Padding="14,0" MinWidth="82"
                        Visibility="Collapsed" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Content="OK" Style="{StaticResource AccentButton}"
                        Height="30" Padding="16,0" MinWidth="82" Margin="8,0,0,0"
                        IsDefault="True" Click="Primary_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
