<Window x:Class="HLAFomReader.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FocusManager.FocusedElement="{Binding ElementName=Box1}">

    <!-- ResizeBorderThickness is 0 because the dialog is fixed size; the 36 DIP caption still drags. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Same caption button as the shell: 44 DIP wide, close hover uses ValidationError. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ValidationError}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">

                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                        Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource AccentBackground}" />
                    <TextBlock x:Name="TitleText" Text="Password" Margin="9,0,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ============ Body ============ -->
        <StackPanel Grid.Row="1" Margin="20,18,20,18">

            <TextBlock x:Name="PromptText" MaxWidth="380" HorizontalAlignment="Left"
                       TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextSecondary}" />

            <PasswordBox x:Name="Box1" Height="30" />

            <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
                <TextBlock Text="CONFIRM PASSWORD" Margin="0,0,0,4"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <PasswordBox x:Name="Box2" Height="30" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11.5"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource ValidationError}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource SubtleButton}"
                        Height="30" Padding="14,0" MinWidth="82" IsCancel="True" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource AccentButton}"
                        Height="30" Padding="16,0" MinWidth="82" Margin="8,0,0,0"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
