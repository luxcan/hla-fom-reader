<UserControl x:Class="HLAFomReader.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HLAFomReader.App.ViewModels"
             xmlns:conv="clr-namespace:HLAFomReader.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             mc:Ignorable="d"
             Background="{DynamicResource SurfaceBackground}"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="{StaticResource FontSizeBody}">

    <UserControl.Resources>

        <!-- One settings group. Recessed surface on a hairline, the same card the detail panes use. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!--
            The cards run the full width of the screen; the sentences inside them do not. A line of
            prose 150 characters long is measurably harder to read than the same words at 90, and
            the eye loses the start of the next line on the way back.

            HorizontalAlignment has to be stated. A Stretch element that MaxWidth cuts short is
            centred by WPF, not left-aligned, which would set every caption adrift from the heading
            above it.
        -->
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- A path, a URL: anything the reader may need to compare character by character. -->
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CardDivider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource Divider}" />
            <Setter Property="Margin" Value="0,15,0,15" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!--
            Standard rather than subtle. A subtle button is transparent until it is hovered, which
            is right on a toolbar where the row itself reads as a set of actions — and wrong here,
            where the same treatment leaves a settings card looking like a paragraph with some words
            in it.
        -->
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Command bar ============ -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Settings" VerticalAlignment="Center"
                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock DockPanel.Dock="Left" Text="Nothing here leaves this machine"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource TextDisabled}" />
            </DockPanel>
        </Border>

        <!-- ============ Body ============
             The cards take the full width of the screen, like every other screen in the app. The
             prose inside them is what needs a measure, not the panels themselves, so that is capped
             per block rather than by narrowing the whole page. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="18,18,18,24">

                <!-- ============ Appearance ============ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeading}" Text="Appearance" />
                        <TextBlock Style="{StaticResource CardCaption}"
                                   Text="The whole window repaints as soon as you choose — there is nothing to restart." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Segmented rather than a switch: on a settings page both options
                                should be readable at once, so nobody has to work out which way an
                                unlabelled toggle goes.
                            -->
                            <Border Grid.Column="0" Style="{StaticResource ThemeSegmentFrame}"
                                    AutomationProperties.Name="Theme">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LightSegment" GroupName="AppTheme"
                                                 Style="{StaticResource ThemeSegment}" Tag="2,0,0,2"
                                                 IsChecked="{Binding Theme, Mode=TwoWay,
                                                             Converter={x:Static conv:EnumToBoolConverter.Instance},
                                                             ConverterParameter=Light}"
                                                 ToolTip="Use the light theme">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE706;" FontSize="11" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource SymbolFontFamily}" />
                                            <TextBlock Text="Light" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <Rectangle Width="1" Fill="{DynamicResource ControlBorder}"
                                               SnapsToDevicePixels="True" />

                                    <RadioButton x:Name="DarkSegment" GroupName="AppTheme"
                                                 Style="{StaticResource ThemeSegment}" Tag="0,2,2,0"
                                                 IsChecked="{Binding Theme, Mode=TwoWay,
                                                             Converter={x:Static conv:EnumToBoolConverter.Instance},
                                                             ConverterParameter=Dark}"
                                                 ToolTip="Use the dark theme">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE708;" FontSize="11" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource SymbolFontFamily}" />
                                            <TextBlock Text="Dark" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding ThemeSourceNote}"
                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Registry database ============ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeading}" Text="Registry database" />
                        <TextBlock Style="{StaticResource CardCaption}"
                                   Text="The SQLite file every registered FOM is stored in. One database at a time; the choice is remembered." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding DatabaseName}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />

                            <Border Margin="10,0,0,0" VerticalAlignment="Center"
                                    Padding="7,2"
                                    CornerRadius="{StaticResource ControlCornerRadiusSmall}"
                                    Background="{DynamicResource StatusAdded}"
                                    Visibility="{Binding IsDatabaseEncrypted, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Encrypted" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusForeground}" />
                            </Border>

                            <Border Margin="10,0,0,0" VerticalAlignment="Center"
                                    Padding="7,2"
                                    CornerRadius="{StaticResource ControlCornerRadiusSmall}"
                                    Background="{DynamicResource StatusNeutral}"
                                    Visibility="{Binding IsDatabasePlaintext, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Not encrypted" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusForeground}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Style="{StaticResource MonoValue}" Margin="0,5,0,0"
                                   Text="{Binding DatabaseFolder}"
                                   ToolTip="{Binding DatabasePath}" />

                        <TextBlock Style="{StaticResource CardCaption}" Margin="0,9,0,0"
                                   Text="{Binding EncryptionDetail}" />

                        <Rectangle Style="{StaticResource CardDivider}" />

                        <WrapPanel>
                            <Button Style="{StaticResource CardButton}" Content="Open database…"
                                    Click="OpenDatabase_Click"
                                    ToolTip="Open or create a different registry database" />

                            <Button Style="{StaticResource CardButton}" Content="Set password…"
                                    Click="SetPassword_Click"
                                    Visibility="{Binding IsDatabasePlaintext, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                    ToolTip="Encrypt this database with a password" />

                            <Button Style="{StaticResource CardButton}" Content="Change password…"
                                    Click="ChangePassword_Click"
                                    Visibility="{Binding IsDatabaseEncrypted, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                            <Button Style="{StaticResource CardButton}" Content="Remove password…"
                                    Click="RemovePassword_Click"
                                    Visibility="{Binding IsDatabaseEncrypted, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                    ToolTip="Decrypt this database back to plaintext" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ About ============ -->
                <Border Style="{StaticResource SettingsCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeading}" Text="About" />

                        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                            <Border Width="44" Height="44" VerticalAlignment="Top"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{DynamicResource AccentBackground}">
                                <TextBlock Text="FOM" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentForeground}" />
                            </Border>

                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding VersionLine}" Margin="0,3,0,0"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}" Margin="0,13,0,0" TextWrapping="Wrap"
                                   MaxWidth="720" HorizontalAlignment="Left"
                                   FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />

                        <!--
                            Updates, as its own panel rather than another row of the card.

                            The card above states what this build IS; this states how to find out
                            whether it is still the current one. They are different questions and a
                            reader looking for the second should not have to parse the first, so it
                            gets its own surface and its own heading.

                            No update check runs behind it. The button hands a URL to the shell and
                            that is the whole mechanism — the app makes no network call of its own,
                            and the copy says so rather than leaving the reader to wonder whether
                            something phoned home when they opened this screen.
                        -->
                        <Border Margin="0,15,0,0" Padding="15,14,15,15"
                                Background="{DynamicResource SurfaceAltBackground}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="9"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBackground}">
                                        <TextBlock Text="&#xE895;" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource SymbolFontFamily}"
                                                   Foreground="{DynamicResource AccentForeground}" />
                                    </Border>
                                    <TextBlock Text="Updates" Margin="9,0,0,0" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>

                                <TextBlock Text="{Binding UpdatesBody}" Margin="0,9,0,0" TextWrapping="Wrap"
                                           MaxWidth="640" HorizontalAlignment="Left"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Height="30" Padding="13,0"
                                            Command="{Binding OpenReleasesCommand}"
                                            ToolTip="Hands the URL to your browser. The app itself makes no network call.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Open releases page" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE8A7;" Margin="7,0,0,0" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource SymbolFontFamily}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource CardButton}" Margin="8,0,0,0" MinWidth="104"
                                            Content="{Binding CopyLinkLabel}"
                                            Command="{Binding CopyReleasesLinkCommand}"
                                            ToolTip="Copy the releases URL to the clipboard" />
                                </StackPanel>

                                <!-- The URL in full, so it can be read or typed without pressing anything. -->
                                <TextBlock Style="{StaticResource MonoValue}" Margin="0,11,0,0"
                                           Text="{Binding ReleasesUrl}" />

                                <Rectangle Style="{StaticResource CardDivider}" />

                                <TextBlock Text="{Binding DownloadNote}" TextWrapping="Wrap"
                                           MaxWidth="640" HorizontalAlignment="Left"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
