<Window x:Class="HLAFomReader.App.Views.DataTypeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HLAFomReader.App.ViewModels"
        xmlns:conv="clr-namespace:HLAFomReader.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DataTypeDetailViewModel}"
        Title="Datatype"
        Width="720" Height="640"
        MinWidth="520" MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Same caption button as the shell: 44 DIP wide, close hover uses ValidationError. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ValidationError}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <!-- Encodings and bounds are read character by character, so they take the mono face. -->
        <Style x:Key="MonoValue" TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="RoleBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadiusSmall}" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Caption ============ -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">

                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                        Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource AccentBackground}" />
                    <TextBlock Text="HLA FOM Reader" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="Datatype" Margin="12,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ============ Title ============ -->
        <Border Grid.Row="1" Padding="20,16,20,14" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimary}" />

                <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" />

                <WrapPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource RoleBadge}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TableLabel}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                    <TextBlock Text="{Binding SourceLabel}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDisabled}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============ Body ============ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,16,20,0">
            <StackPanel>

                <!-- Encoding: the same canonical form the map's column shows, spelled out. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="ENCODING" />

                        <TextBlock Style="{StaticResource MonoValue}" Text="{Binding Canonical}" FontSize="13.5" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="WIDTH" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding WidthText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="BYTE ORDER" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding EndianText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding HasRepresentation, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CARRIED IN" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Representation}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding Representation}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Value range. Derived, never authored — so the basis is always shown beside it. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="VALUE RANGE" />

                        <Grid Visibility="{Binding HasRange, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINIMUM" />
                                <TextBlock Style="{StaticResource MonoValue}" Text="{Binding RangeMinimum}" FontSize="13.5" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MAXIMUM" />
                                <TextBlock Style="{StaticResource MonoValue}" Text="{Binding RangeMaximum}" FontSize="13.5" />
                            </StackPanel>

                            <!-- The OMT tabulates no bounds, so these are derived. Saying what from is
                                 not a footnote: it is what stops a derived bound reading as an
                                 authored one. -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="DERIVED FROM" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding RangeBasis}" FontSize="12" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                       Style="{StaticResource FieldValue}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding RangeNote}"
                                       Visibility="{Binding HasRangeNote, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldValue}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding NoRangeReason}"
                                   Visibility="{Binding HasRange, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <!-- What the FOM authored: the half a canonical form deliberately throws away. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasAnyProperty, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="AS THE FOM DECLARES IT" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0"
                                        Visibility="{Binding HasUnits, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="UNITS" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Units}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0"
                                        Visibility="{Binding HasResolution, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RESOLUTION" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Resolution}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding HasAccuracy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ACCURACY" />
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Accuracy}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasCardinality, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CARDINALITY" />
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Cardinality}" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasInterpretation, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="INTERPRETATION" />
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Interpretation}" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasEncodingNote, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="ENCODING NOTE" />
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding EncodingNote}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Structure. This is what "if struct, it will of course display more" means. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasMembers, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding MembersHeader}" />

                        <TreeView ItemsSource="{Binding Members}" BorderThickness="0"
                                  Background="Transparent" MaxHeight="420"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource RoleBadge}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Role}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextDisabled}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding MeasureText}" FontSize="10.5" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource TextDisabled}"
                                                       Visibility="{Binding HasMeasure, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                                            <TextBlock Text="{Binding Truncation}" FontSize="10.5" Margin="0,1,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ValidationError}"
                                                       Visibility="{Binding IsTruncated, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Encoding}" FontSize="11.5"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Encoding}" />

                                            <TextBlock Text="{Binding RangeText}" FontSize="10.5" Margin="0,1,0,0"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                                       Foreground="{DynamicResource TextDisabled}"
                                                       TextAlignment="Right"
                                                       Visibility="{Binding HasRange, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </Border>

                <!-- Semantics prose, last: it is the longest and the least often needed. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSemantics, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="SEMANTICS" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Semantics}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Why the answer is incomplete, when it is. -->
                <Border Style="{StaticResource Card}"
                        BorderBrush="{DynamicResource AccentBackground}" BorderThickness="2,0,0,0"
                        CornerRadius="0"
                        Visibility="{Binding IsTruncated, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Style="{StaticResource FieldValue}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding Truncation}" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ Footer ============ -->
        <Border Grid.Row="3" Padding="20,12" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <Button Style="{StaticResource AccentButton}" Content="Close" HorizontalAlignment="Right"
                    Height="30" Padding="20,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </Border>

    </Grid>
</Window>
