<Window x:Class="HLAFomReader.App.Views.DatabasePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registry database"
        Width="480" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ResizeBorderThickness is 0 because the dialog is fixed size; the 36 DIP caption still drags. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Same caption button as the shell: 44 DIP wide, close hover uses ValidationError. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ValidationError}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of the two choices: a surface card so neither reads as the "small print" of the other. -->
        <Style x:Key="ChoiceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="ChoiceHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="ChoiceCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">

                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                        Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource AccentBackground}" />
                    <TextBlock Text="HLA FOM Reader" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="Registry database" Margin="12,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ============ Body ============ -->
        <StackPanel Grid.Row="1" Margin="20,18,20,18">

            <TextBlock Text="Choose a registry database" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />

            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="HLAFomReader keeps every parsed FOM in a SQLite database, so it needs to know which one to use before it can start. Open a database you already have, or create a fresh one." />

            <!-- Open an existing database -->
            <Border Style="{StaticResource ChoiceCard}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource ChoiceHeading}" Text="Open an existing database" />
                    <TextBlock Style="{StaticResource ChoiceCaption}"
                               Text="Pick up a registry you or a colleague created earlier. If the file turns out to be encrypted you will be asked to unlock it." />
                    <Button Content="Open existing…" Style="{StaticResource AccentButton}"
                            Height="30" Padding="16,0" Margin="0,12,0,0"
                            HorizontalAlignment="Left" IsDefault="True" Click="OpenExisting_Click" />
                </StackPanel>
            </Border>

            <!-- Create a new database -->
            <Border Style="{StaticResource ChoiceCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource ChoiceHeading}" Text="Create a new database" />
                    <TextBlock Style="{StaticResource ChoiceCaption}"
                               Text="Start an empty registry. Tick the box below to protect it with a password — the file is then encrypted and cannot be opened without it." />
                    <CheckBox x:Name="ProtectWithPassword" Margin="0,12,0,0" FontSize="11.5"
                              Content="Protect the new database with a password" />
                    <Button Content="Create new…" Height="30" Padding="16,0" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="CreateNew_Click" />
                    <TextBlock x:Name="SuggestedPathText" Margin="0,8,0,0" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextDisabled}" />
                </StackPanel>
            </Border>

            <Button Content="Cancel" Style="{StaticResource SubtleButton}"
                    Height="30" Padding="14,0" MinWidth="82" Margin="0,18,0,0"
                    HorizontalAlignment="Right" IsCancel="True" />

        </StackPanel>
    </Grid>
</Window>
