<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HLAFomReader</AssemblyName>
    <RootNamespace>HLAFomReader.App</RootNamespace>
    <ApplicationIcon>Assets\HLAFomReader.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Shown on the exe's Details tab in Explorer. -->
  <PropertyGroup>
    <Product>HLA FOM Reader</Product>
    <AssemblyTitle>HLA FOM Reader</AssemblyTitle>
    <Description>Register HLA FOMs and compare them — HLA 1.3 (.fed) and IEEE 1516 / HLA Evolved (.xml).</Description>
    <Company>HLAFomReader</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!--
    The day the build was compiled, read back by BuildInfo and shown on the About card.

    A date is what answers "am I running the build I just made?". Builds reach this app by hand as
    often as by tag, and a publish that silently left the old exe in place looks exactly like a
    change that did not work — which has happened. The commit hash cannot answer it: it is the same
    for every rebuild of the same source.

    The cost is that the assembly is no longer byte-identical across days, so this is the one thing
    in the build that is deliberately not deterministic.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <!--
    Publish settings. These only take effect for 'dotnet publish' (see the win-x64 profile);
    they deliberately leave 'dotnet build' and 'dotnet run' as fast framework-dependent builds.
    WPF does not support trimming, so PublishTrimmed is never set — the self-contained output is
    large by design.
  -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HLAFomReader.Core\HLAFomReader.Core.csproj" />
  </ItemGroup>

</Project>
